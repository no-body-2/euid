{
  "name": "euid",
  "version": "0.1.0",
  "description": "Emoji Unique Identifier - secure Base1024 emoji IDs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "euid",
    "emoji",
    "unique-id",
    "uuid",
    "cuid",
    "cuid2",
    "nanoid",
    "base1024",
    "time-sortable",
    "human-centric",
    "identifier",
    "fun"
  ],
  "author": "no-body-2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no-body-2/euid.git"
  },
  "bugs": {
    "url": "https://github.com/no-body-2/euid/issues"
  },
  "homepage": "https://github.com/no-body-2/euid#readme",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}